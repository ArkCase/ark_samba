#!/bin/bash

set -euo pipefail
. /.functions

DEBUG="$(to_boolean "${DEBUG:-false}")"

${DEBUG} && set -x

set_or_default BASE_DIR "/app"
set_or_default INIT_DIR "${BASE_DIR}/init"
set_or_default CONF_DIR "${BASE_DIR}/conf"
set_or_default BOOT_DIR "${BASE_DIR}/boot"
set_or_default BACKEND_STORE_SIZE_GB "8"
set_or_default LOG_ARCHIVE_COUNT "10"

[[ "${BACKEND_STORE_SIZE_GB}" =~ ^[1-9][0-9]*$ ]] || fail "The value for BACKEND_STORE_SIZE_GB is not a valid number: [${BACKEND_STORE_SIZE_GB}]"

SMB_CONF="/etc/samba/smb.conf"
KRB_CONF="/etc/krb5.conf"

set_or_default SAMBA_STATE "/var/lib/samba"
export SAMBA_STATE

export SAMBA_PRIVATE="${SAMBA_STATE}/private"

#
# Set and normalize variables
#
DOMAINPASS="${DOMAINPASS:-youshouldsetapassword}"
NOCOMPLEXITY="${NOCOMPLEXITY:-false}"
INSECURELDAP="${INSECURELDAP:-false}"
HOSTIP="${HOSTIP:-NONE}"

DOMAIN="${DOMAIN:-SAMDOM.LOCAL}"
LDOMAIN="${DOMAIN,,}"
UDOMAIN="${DOMAIN^^}"
REALM="${UDOMAIN%%.*}"

export INTERFACES="$(cat /proc/net/dev | tail -n +3 | awk '{ print $1 }' | tr -d ':' | xargs)"
[ -n "${POD_IP:-}" ] && INTERFACES+=" ${POD_IP}"

#
# TODO for clustering:
#
# When booting up, analyze the pod's name. Pod #0 will *ALWAYS* be the master DC, and
# all other pods will be joined as backups. That means that on first boot, all pods
# except the master MUST wait for the master to boot up cleanly before they can
# themselves be joined/whatnot.
#
# After the first boot is a different story we've yet to figure out fully b/c
# what happens if they come back up but the master isn't around, but other pods
# in the cluster are? Is it safe to sync up with that one? What is the correct play?
#

D2=()
IFS="." read -r -a D2 <<< "${DOMAIN}"
D3=()
for P in "${D2[@]}" ; do
	D3+=("DC=${P^^}")
done

DC=""
for P in "${D3[@]}" ; do
	[ -n "${DC}" ] && DC="${DC},"
	DC="${DC}${P}"
done
unset D2 D3

TIMESTAMP="$(date +%Y%m%d-%H%M%S)"

backup_file()
{
	local FILE="${1}"
	[ -f "${FILE}" ] && mv -vf "${FILE}" "${FILE}.bak-${TIMESTAMP}"
	return 0
}

reset_data()
{
	say "Cleaning up any vestigial configurations"
	rm -rf "${SAMBA_STATE}"/* /var/log/samba/*
	tar -C / -xzf /samba-directory-templates.tar.gz
}

#
# This function will check to see if the instance can be considered
# "provisioned" (i.e. domain created and configured)
#
is_provisioned()
{
	local CANDIDATES=()

	#
	# Common data
	#
	CANDIDATES+=("share_info.tdb")

	#
	# Private data
	#
	CANDIDATES+=("private/dns_update_list")
	CANDIDATES+=("private/encrypted_secrets.key")
	CANDIDATES+=("private/hklm.ldb")
	CANDIDATES+=("private/idmap.ldb")
	CANDIDATES+=("private/privilege.ldb")
	CANDIDATES+=("private/sam.ldb")
	CANDIDATES+=("private/secrets.keytab")
	CANDIDATES+=("private/secrets.ldb")
	CANDIDATES+=("private/secrets.tdb")
	CANDIDATES+=("private/share.ldb")
	CANDIDATES+=("private/spn_update_list")
	CANDIDATES+=("private/sam.ldb.d/metadata.tdb")

	#
	# Check for the created databases
	#
	local MISSING="false"
	for C in "${CANDIDATES[@]}" ; do
		C="${SAMBA_STATE}/${C}"
		is_file_readable "${C}" && continue
		as_boolean "${MISSING}" || err "The following state files were not found"
		MISSING="true"
		err "${C}"
	done
	as_boolean "${MISSING}" && return 1

	#
	# Check to see which domains are housed here (must be exactly 0 or 1, and
	# the "one" MUST match our configured domain)
	#
	local DOMAINS=()
	readarray -t DOMAINS < <(find "${SAMBA_STATE}/private/sam.ldb.d" -type f -name 'CN=CONFIGURATION,*.ldb' | sed -e 's;^.*/CN=CONFIGURATION,;;g' -e 's;[.]ldb$;;g' -e 's;DC=;;g' -e 's;,;.;g' | tr '[[:upper:]]' '[[:lower:]]' | sort -u)

	# There must be EXACTLY zero or one domains
	case "${#DOMAINS[@]}" in
		# No data! No problem!
		0 ) ;;

		# Data for another domain? Is it ours? If not, KABOOM!
		1 ) [ "${DOMAIN,,}" == "${DOMAINS[0]}" ] || fail "This Samba persistent state belongs to the domain [${DOMAINS[0]}], but this pod is configured for the domain ${DOMAIN,,}" ;;

		# Data for more than one domain?!?! HOW?!?! Well... doesn't matter ... KABOOM!
		* ) fail "This Samba persistent state appears to store data for the domains [ ${DOMAINS[@]} ], but this pod is configured for the domain ${DOMAIN,,}" ;;
	esac

	#
	# Verify the rest of the domain configurations...
	#
	local DOMAIN_DATA_DIR="${SAMBA_STATE}/private/sam.ldb.d"
	local DOMAIN_DATA=()
	DOMAIN_DATA+=("CN=CONFIGURATION,${DC}.ldb")
	DOMAIN_DATA+=("CN=SCHEMA,CN=CONFIGURATION,${DC}.ldb")
	DOMAIN_DATA+=("DC=DOMAINDNSZONES,${DC}.ldb")
	DOMAIN_DATA+=("DC=FORESTDNSZONES,${DC}.ldb")
	DOMAIN_DATA+=("${DC}.ldb")
	MISSING="false"
	for C in "${DOMAIN_DATA[@]}" ; do
		# Look for the file without URL-encoding
		F="${DOMAIN_DATA_DIR}/${C}"
		is_file_readable "${F}" && continue

		# Sometimes the filename is URL-encoded...so look for that as well
		E="${DOMAIN_DATA_DIR}/$(urlencode "${C}")"
		is_file_readable "${E}" && continue

		as_boolean "${MISSING}" || err "Samba common state appears to be present, but the following domain data files were not found"
		MISSING="true"
		err "${F}"
	done
	as_boolean "${MISSING}" && fail "Some Samba configurations were found, but not the domain databases - can't continue!"

	#
	# We're fully configured, so we don't have to redo it
	#
	ok "Domain data is already provisioned!"
	return 0
}

# This function provides backwards compatibility. We're phasing out
# direct invocation of gucci in favor of the wrapper script which
# will eventually allow us to replace the template renderer completely
render_template()
{
	local TC_VAR="TEMPLATE_COMMAND"
	if [ ! -v "${TC_VAR}" ] ; then
		local CMD=( "render-template" "gucci" )
		# Be backwards-compatible as a contingency
		for C in "${CMD[@]}" ; do
			type -P "${C}" &>/dev/null || continue
			declare -g "${TC_VAR}"="${C}"
			break
		done
		[ -v "${TC_VAR}" ] || fail "No tool present to render the template with. Candidates: [ ${CMD[@]@Q} ]"
	fi
	"${TEMPLATE_COMMAND}"
}

configure_krb()
{
	#
	# Configure Kerberos
	#
	render_template < "${KRB_CONF}.template" > "${KRB_CONF}"

	return 0
}

render_smb_conf()
{
	#
	# Configure Samba
	#
	# Must not be left to the caller: it would wipe the existing domain data on a non-0 status
	render_template < "${SMB_CONF}.template" > "${SMB_CONF}" || fail "Failed to render the Samba configuration at [${SMB_CONF}] (rc=${?})"

	return 0
}

configure_smb()
{
	is_provisioned && render_smb_conf && ok "Samba is already configured!" && return 0

	say "Configuring the domain"

	# Should we do this?
	reset_data

	# Set host ip option
	HOSTIP_OPTION=""
	[ "${HOSTIP}" != "NONE" ] && HOSTIP_OPTION="--host-ip=${HOSTIP}"

	# If the finished file isn't there, this is brand new, we're not just moving to a new container
	mv "${SMB_CONF}" "${SMB_CONF}.orig"

	PROVISION_FLAGS=()
	[ -n "${HOSTIP_OPTION}" ] && PROVISION_FLAGS+=("${HOSTIP_OPTION}")
	samba-tool domain provision --use-rfc2307 --domain="${REALM}" --backend-store=mdb --backend-store-size="${BACKEND_STORE_SIZE_GB}Gb" --realm="${UDOMAIN}" --server-role=dc --dns-backend=SAMBA_INTERNAL --adminpass="${DOMAINPASS}" "${PROVISION_FLAGS[@]}" || return 1
	if [[ ${NOCOMPLEXITY,,} == "true" ]]; then
		samba-tool domain passwordsettings set --complexity=off || return 1
		samba-tool domain passwordsettings set --history-length=0 || return 1
		samba-tool domain passwordsettings set --min-pwd-age=0 || return 1
		samba-tool domain passwordsettings set --max-pwd-age=0 || return 1
	fi

	# TODO: for auto-join of backup DCs ...
	# samba-tool domain join "${LDOMAIN}" DC -U"${REALM}\\Administrator" --password="${DOMAINPASS}" --dns-backend=SAMBA_INTERNAL

	render_smb_conf

	# Apply extra initializations, if needed
	local INIT_SCRIPTS="${INIT_DIR}/init.d"
	if [ -d "${INIT_SCRIPTS}" ] ; then
		say "Launching extra initializations from [${INIT_SCRIPTS}]..."
		cd "${INIT_SCRIPTS}" || exit 1
		while read script ; do
			say "\tLaunching the extra initializer script [${script}]..."
			RC=0
			"$(readlink -f "${script}")" < /dev/null || RC=${?}
			if [ ${RC} -ne 0 ] ; then
				say "\tError executing the initializer script [${script}] (rc=${RC})"
				return 1
			fi
		done < <(find . -mindepth 1 -maxdepth 1 -type f -perm /u+x | sort | sed -e 's;^./;;g')
	fi

	say "Initialization complete"
	return ${?}
}

configure_k8s()
{
	local DNS_IP=""

	[ -v KUBERNETES_SERVICE_HOST ] || return 1

	# Lookup the DNS name kube-dns.kube-system.svc.cluster.local
	local CLUSTER_DOMAIN="$(get_cluster_domain)"
	local K8S_DNS=""
	K8S_DNS="$(dig +short "kube-dns.kube-system.svc.${CLUSTER_DOMAIN}")" || return 1
	[ -n "${K8S_DNS}" ] || return 1
	echo "${K8S_DNS}"
}

# In case we're in Kubernetes
set_or_default DNSFORWARDER
[ -n "${DNSFORWARDER}" ] || DNSFORWARDER="$(configure_k8s)" || say "Kubernetes configurations not available"
export DNSFORWARDER
