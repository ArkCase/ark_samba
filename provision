#!/bin/bash

set -euo pipefail
. /.functions
define_base_vars

. "${__BASEDIR}/samba-common" || fail "Failed to load the samba-common library"

cleanup()
{
	local RC=${?}
	if [ -v SAMBA_PID ] && [ -n "${SAMBA_PID}" ] && kill -0 "${SAMBA_PID}" &>/dev/null ; then
		eyes "Shutting down Samba ..."
		kill -TERM "${SAMBA_PID}" &>/dev/null || true
		wait "${SAMBA_PID}" &>/dev/null || true
	fi
	return ${RC}
}

#
# Configure the components
#
running "Provisioning the Samba domain ${LDOMAIN@Q} (${REALM} / ${DC})"
configure_krb
configure_smb
ok "The Samba domain has been provisioned!"
