#!/bin/bash

set -euo pipefail
. /.functions
define_base_vars

. "${__BASEDIR}/samba-common" || fail "Failed to load the samba-common library"

cleanup()
{
	local RC=${?}
	if [ -v SAMBA_PID ] && [ -n "${SAMBA_PID}" ] && kill -0 "${SAMBA_PID}" &>/dev/null ; then
		eyes "Shutting down Samba ..."
		kill -TERM "${SAMBA_PID}" &>/dev/null || true
		wait "${SAMBA_PID}" &>/dev/null || true
	fi
	return ${RC}
}

#
# Configure the components
#
running "Provisioning the Samba domain ${LDOMAIN@Q} (${REALM} / ${DC})"
configure_krb
configure_smb
ok "The Samba domain has been provisioned!"

running "Running Samba to initialize everything else ..."
trap cleanup EXIT
coproc /usr/sbin/samba -F
SAMBA_PID="${COPROC_PID:-}"

sleeping "Sleeping for a bit to let Samba boot up and initialize..."
sleep 3

doing "Resuming provisioning!"

set_or_default PROVISIONING_TIMEOUT "90s"

PROVISIONING_TIMEOUT_SECS="$(timestr_to_secs "${PROVISIONING_TIMEOUT}")" || fail "Failed to parse the PROVISIONING_TIMEOUT ${PROVISIONING_TIMEOUT@Q}"
PROVISIONING_TIMEOUT="$(secs_to_timestr "${PROVISIONING_TIMEOUT_SECS}")"

START="$(date -u +%s)"
DEADLINE=$(( START + PROVISIONING_TIMEOUT_SECS ))
FIRST="true"
OK="false"
while [ "$(date -u +%s)" -lt ${DEADLINE} ] ; do
	kill -0 "${SAMBA_PID}" &>/dev/null || fail "Samba seems to have crashed while it was initializing!"

	as_boolean "${FIRST}" || sleep 1 || fail "Interrupted while waiting for the net poll"
	FIRST="false"

	# Run the test
	samba-tool ou listobjects "OU=Users,OU=ArkCase" &>/dev/null || continue
	samba-tool ou listobjects "OU=Groups,OU=ArkCase" &>/dev/null || continue

	OK="true"
	ok "Provisioning complete!"
	break
done

as_boolean "${OK}" || fail "Provisioning failed"
ok "Provisioning complete!"
